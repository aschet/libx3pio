# mktime() of the C library changes the time zone state under a lock of its
# own, which ThreadSanitizer cannot see in a library that was not built with it.
# minizip-ng calls it for the time stamp of every member that it reads.
race:mz_zip_dosdate_to_time_t
race:mz_zip_tm_to_time_t
